ed , undefined , undefined , undefined , false ); DOCS_warmStartDocumentLoader = KX_kixApp.getWarmStartDocumentLoader(); DOCS_cseBlobArtifactsHolder = KX_kixApp.getCseBlobArtifactsHolder(); DOCS_initialLoadTiming = KX_kixApp.getInitialLoadTiming(); KX_getLatencyStats = function() {return KX_kixApp.getPerformanceManager().getInitialLoadStats();}; KX_resize = function() {KX_kixApp.resize();}; _docs_annotate_getAnnotatedText = function(id) {return KX_kixApp.getAnnotatedText(id);};}DOCS_timing['sac'] = new Date().getTime(); KX_startKix(); DOCS_initialLoadTiming.setTime('eac');</script><script nonce="DdGKMlUoUR2Jb_2wFrCmKQ">DOCS_warmStartDocumentLoader.startLoad( 1249.0 ,'IwdBl1VHMp6Eig', 2.147483647E9 , 61.0 ,[2147483647,"AAE\u003d"], null , null ); var DOCS_modelChunkLoadStart; var DOCS_modelChunkParseStart; var DOCS_modelChunk;</script><script nonce="DdGKMlUoUR2Jb_2wFrCmKQ">DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="DdGKMlUoUR2Jb_2wFrCmKQ">DOCS_modelChunk = {"chunk":[{"ty":"mkch","d":[[1,"Main Manuscript"]]},{"ty":"ac","d":["t.mfl7fi6ao916",[1,"Supplementary"],[1]]},{"ty":"utlp","d":[[[],[1,"en"]]]},{"ty":"is","ibi":1,"s":"Target Journal: PLOS Biology as a Methods and Resources paper\n\n\nThis is the working copy as of July 1, 2026\u000b\u000bThe Bat Taxonomic Alignment: A Tool for Tracking Taxonomic Change in Bats and Improving Biodiversity Data Integration\n\nSherman, Aja C1.; Montauban, Cecilia2,3; Agosti, Donat; Groom, Quentin; Morales, Ariadna E; Oliveira, Hernani F. M.; Phelps, Kendra; Poelen, Jorrit H.; Reeder, DeeAnn M.; Simmons, Nancy B.; Tanshi, I; Upham, Nathan S.; Willoughby, Anna R; Zijlstra, J. S.; Geiselman, Cullen1\n\n1Bat Eco-Interaction Project\n2Department of Zoology and Entomology, University of Pretoria, Pretoria, South Africa\n3Department of Life Sciences, Imperial College London, Ascot, London, UK\nPlazi\n Departamento de Fitopatologia, Universidade de Brasília, Brasília, DF, Brazil\nDepartamento de Zoologia, Universidade Federal do Paraná, Curitiba, PR, Brazil\nCollege of Veterinary Medicine, University of Minnesota, St. Paul, MN, USA\nRonin Institute for Independent Scholarship, Monclair, NJ, USA\nCenter for Biodiversity and Ecological Restoration, UC Santa Barbara, Santa Barbara, CA, USA, \nBucknell University, Department of Biology, Lewisburg, PA, USA\nDepartment of Mammalogy, Division of Vertebrate Zoology, American Museum of Natural History, New York, NY 10024\nDepartment of Biology, University of Washington, Seattle, USA.\nSmall Mammal Conservation Organization, Benin City, Nigeria.\nArizona State University, School of Life Sciences, Tempe, AZ, USA\nOdum School of Ecology, University of Georgia, GA, USA\nMeise Botanic Garden, Meise, Belgium\n\nCorresponding author: Aja C. Sherman \nEmail: aja@batbase.org\n\n\n\n\f\nAbstract \nSpecies names provide the foundation for organizing biological knowledge, linking information across evolution, conservation, "},{"ty":"iss","sugid":"suggest.iyfwhybcxtmm","ibi":1750,"s":"ecology"},{"ty":"is","ibi":1757,"s":"genomics, epidemiology, and biodiversity monitoring. Yet the taxonomic concepts associated with those names often change through time, creating challenges for interpreting and integrating data collected under different classifications. Bats"},{"ty":"iss","sugid":"suggest.7hd5yluykb2h","ibi":1997,"s":", the second most diverse order among mammals,"},{"ty":"is","ibi":2043,"s":" provide a useful model system for examining these challenges because they have undergone extensive taxonomic revision in recent decades and increasingly serve as focal taxa in research ranging from conservation to disease ecology. To address this challenge, we developed the Bat Taxonomic Alignment (BTA), a framework that reconciles taxonomic concepts across "},{"ty":"iss","sugid":"suggest.i91urkgfrmji","ibi":2404,"s":"ten "},{"ty":"is","ibi":2408,"s":"fifteen major bat authorities spanning 45 years (1980–2025). The BTA enables users to track how species "},{"ty":"iss","sugid":"suggest.gapd6so96rya","ibi":2512,"s":"delimitations"},{"ty":"is","ibi":2525,"s":"concepts have changed through time, linking historical and contemporary classifications while preserving provenance and alternative treatments. Application of the framework revealed substantial disagreement among contemporary taxonomic authorities, with hundreds of conflicting species treatments persisting despite increasing efforts toward standardization. To demonstrate its utility, we used the BTA to audit taxonomic consistency within the IUCN Red List, identifying 287 taxonomic "},{"ty":"iss","sugid":"suggest.43yanwmgq1on","ibi":3011,"s":"needed "},{"ty":"is","ibi":3018,"s":"modifications"},{"ty":"iss","sugid":"suggest.yiff4cfoo6ea","ibi":3031,"s":","},{"ty":"is","ibi":3032,"s":" affecting ~20% of assessed bat species, and demonstrating how taxonomic discrepancies can propagate into conservation infrastructure. Although developed using bats as a model system, the challenges addressed by the BTA extend across biodiversity science wherever changing taxonomies influence the interpretation of biological data. By making taxonomic concepts explicit, traceable, and interoperable, the framework supports more transparent, reproducible, and integrated use of biological data.\n\nKeywords: Taxonomic concepts; Taxonomic alignment; Biodiversity informatics; Biodiversity data integration; Species concepts\n\f\nIntroduction \nTaxonomy is the primary indexing system of biological knowledge. Taxonomic names link data from field observations to museum specimens, genomic sequences to ecological interactions, hosts to pathogen records, and conservation status to legal protections. Across disciplines, species names function as the keys by which data are organized, integrated, and interpreted. Effective research, management, and policy depend on clearly defined taxonomic units that reflect biological reality and can be tracked through space and time (Voigt et al 2016; Lyal et al. 2008; Sharma et al. 2024). In this sense, taxonomy is not merely a classificatory exercise; it is the foundational infrastructure for biodiversity science, public health, and environmental governance ("},{"ty":"iss","sugid":"suggest.swesxdsghjqj","ibi":4429,"s":"Abrahamse, 2021"},{"ty":"is","ibi":4444,"s":"CITE CITE).\n"},{"ty":"as","st":"document","si":0,"ei":0,"sm":{"ds_lhs":1,"ds_fi":"kix.hf1","ds_ulhfl":false,"ds_hi":"kix.hf0"}},{"ty":"ae","et":"list","id":"kix.list.1","epm":{"le_nb":{"nl_4":{"b_gf":"%4.","b_ts":{"ts_un":false,"ts_un_i":false,"ts_sc":false,"ts_it_i":true,"ts_fgc2":{"hclr_color":"#000000","clr_type":0},"ts_st_i":true,"ts_bgc2":{"hclr_color":null,"clr_type":0},"ts_fs_i":true,"ts_ff_i":true,"ts_bgc2_i":true,"ts_it":false,"ts_va":"nor","ts_bd_i":true,"ts_va_i":true,"ts_fs":11.0,"ts_ff":"Arial","ts_st":false,"ts_bd":false,"ts_fgc2_i":true,"ts_sc_i":true,"ts_tw":400},"b_ifl":162.0,"b_gs":"","b_a":0,"b_sn":1,"b_gt":13,"b_il":180.0},"nl_3":{"b_gf":"%3.","b_ts":{"ts_un":false,"ts_un_i":false,"ts_sc":false,"ts_it_i":true,"ts_fgc2":{"hclr_color":"#000000","clr_type":0},"ts_st_i":true,"ts_bgc2":{"hclr_color":null,"clr_type":0},"ts_fs_i":true,"ts_ff_i":true,"ts_bgc2_i":true,"ts_it":false,"ts_va":"nor","ts_bd_i":true,"ts_va_i":true,"ts_fs":11.0,"ts_ff":"Arial","ts_st":false,"ts_bd":false,"ts_fgc2_i":true,"ts_sc_i":true,"ts_tw":400},"b_ifl":126.0,"b_gs":"","b_a":0,"b_sn":1,"b_gt":10,"b_il":144.0},"nl_2":{"b_gf":"%2.","b_ts":{"ts_un":false,"ts_un_i":false,"ts_sc":false,"ts_it_i":true,"ts_fgc2":{"hclr_color":"#000000","clr_type":0},"ts_st_i":true,"ts_bgc2":{"hclr_color":null,"clr_type":0},"ts_fs_i":true,"ts_ff_i":true,"ts_bgc2_i":true,"ts_it":false,"ts_va":"nor","ts_bd_i":true,"ts_va_i":true,"ts_fs":11.0,"ts_ff":"Arial","ts_st":false,"ts_bd":false,"ts_fgc2_i":true,"ts_sc_i":true,"ts_tw":400},"b_ifl":90.0,"b_gs":"","b_a":2,"b_sn":1,"b_gt":15,"b_il":108.0},"nl_1":{"b_gf":"%1.","b_ts":{"ts_un":false,"ts_un_i":false,"ts_sc":false,"ts_it_i":true,"ts_fgc2":{"hclr_color":"